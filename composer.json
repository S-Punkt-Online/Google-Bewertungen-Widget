{
  "name": "s-punkt-online/contao-google-reviews-widget",
  "description": "Google Reviews Widget for Contao CMS with frontend module and content element support.",
  "type": "contao-bundle",
  "license": "MIT",

  "keywords": [
    "contao",
    "google reviews",
    "bewertungen",
    "widget",
    "seo",
    "local business"
  ],

  "homepage": "https://www.s-punkt-online.de",

  "support": {
