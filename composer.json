{
  "name": "s-punkt-online/contao-google-reviews-widget",
  "description": "Google Reviews Widget for Contao CMS with frontend module and content element support.",
  "type": "contao-bundle",
  "license": "MIT",

  "keywords": [
    "contao",
    "google reviews",
    "bewertungen",
    "widget",
    "seo",
    "local business"
  ],

  "homepage": "https://www.s-punkt-online.de",

  "support": {
    "source": "https://github.com/S-Punkt-Online/Google-Bewertungen-Widget"
  },

  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3",
    "contao/manager-plugin": "^2.13",
    "psr/log": "^3.0",
    "symfony/http-client-contracts": "^3.0"
  },

  "require-dev": {
    "contao/easy-coding-standard": "^7.1",
    "phpunit/phpunit": "^10.5",
    "symfony/http-client": "^6.4"
  },

  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },

  "autoload": {
    "psr-4": {
      "SPunktOnline\\ContaoGoogleReviewsWidget\\": "src/"
    }
  },

  "autoload-dev": {
    "psr-4": {
      "SPunktOnline\\ContaoGoogleReviewsWidget\\Tests\\": "tests/"
    }
  },

  "extra": {
    "contao-manager-plugin": "SPunktOnline\\ContaoGoogleReviewsWidget\\ContaoManager\\Plugin"
  }
}
