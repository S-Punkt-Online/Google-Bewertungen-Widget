  },

  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3",
    "contao/manager-plugin": "^2.13"
  },

  "autoload": {
    "psr-4": {
      "SPunktOnline\\ContaoGoogleReviewsWidget\\": "src/"
    }
  },

  "extra": {
    "contao-manager-plugin": "SPunktOnline\\ContaoGoogleReviewsWidget\\ContaoManager\\Plugin"
  }
